# AirTalk nginx — HTTPS 모드(서버가 인터넷에 직접 열려 있을 때). 인증서: deploy/certs/fullchain.pem·privkey.pem
# 환경변수(docker-compose): SERVER_NAME(도메인), ADMIN_ALLOW(관리자 화면을 열어 줄 IP 대역, 기본 all)
map $http_upgrade $connection_upgrade { default upgrade; '' close; }
map $http_x_forwarded_proto $airtalk_proto { default https; }   # 이 모드에선 클라이언트가 보낸 값을 믿지 않는다

server {
    listen 80;
    server_name ${SERVER_NAME};
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    server_tokens off;
    client_max_body_size 20m;   # 용어집 업로드(최대 16MB)

    # 관리자 화면·관리자 API — 공사 내부 IP 대역에서만(ADMIN_ALLOW). 같은 주소·포트라 nginx 에서 막는다
    location ~ ^/(admin|api/admin)(/|$) {
        allow ${ADMIN_ALLOW};
        deny all;
        include /etc/nginx/conf.d/airtalk-proxy.inc;
    }
    location / {
        include /etc/nginx/conf.d/airtalk-proxy.inc;
    }
}
